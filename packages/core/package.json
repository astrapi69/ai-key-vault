{
    "name": "@astrapi69/ai-key-vault",
    "version": "0.1.1",
    "description": "Storage-agnostic BYOK AI provider settings core: provider registry, key store adapter interface, passphrase-encrypted key vault, browser-direct chat clients with SSE streaming, and model discovery",
    "license": "MIT",
    "author": "Asterios Raptis",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/astrapi69/ai-key-vault.git",
        "directory": "packages/core"
    },
    "keywords": ["ai", "byok", "api-key", "vault", "anthropic", "openai", "gemini", "streaming"],
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "files": ["dist", "README.md"],
    "sideEffects": false,
    "scripts": {
        "build": "tsup"
    },
    "dependencies": {
        "@astrapi69/passphrase-vault": "0.1.1"
    },
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=20"
    }
}
