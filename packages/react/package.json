{
    "name": "@astrapi69/ai-key-vault-react",
    "version": "0.1.1",
    "description": "React UI for BYOK AI provider settings and the encrypted key vault: settings panel, provider table, key vault import/export — storage-, i18n- and UI-slot-injectable",
    "license": "MIT",
    "author": "Asterios Raptis",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/astrapi69/ai-key-vault.git",
        "directory": "packages/react"
    },
    "keywords": ["react", "ai", "byok", "api-key", "vault", "settings", "components"],
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "files": ["dist", "README.md"],
    "sideEffects": false,
    "scripts": {
        "build": "tsup"
    },
    "dependencies": {
        "@astrapi69/ai-key-vault": "0.1.0"
    },
    "peerDependencies": {
        "react": "^18 || ^19"
    },
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=20"
    }
}
